###< symfony/framework-bundle ###
SYMFONY_DEPRECATIONS_HELPER=weak
 
# Panther (local dev)
PANTHER_BROWSER=chrome
PANTHER_HEADLESS=1
#PANTHER_PROFILE_DIR=/var/tmp/panther-fb-profile
# Optional: set explicit binaries if needed
PANTHER_CHROMEDRIVER_BINARY="/Users/lucas/Projects/Web/main_dashboard/drivers/chromedriver"
PANTHER_CHROME_BINARY="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
#PANTHER_REMOTE_URL=http://127.0.0.1:4444
FACEBOOK_EMAIL='lucas.itbiz@gmail.com'
FACEBOOK_PASSWORD='Pwd4Logon@Meta!!'
FB_DUMP_HTML=1
PANTHER_DEVTOOLS=0

# Proxy settings for Panther/php-webdriver (used by FacebookService)
# Supported formats: http://user:pass@host:port, https://host:port, socks5://host:port
# Leave empty to disable proxy.
PANTHER_PROXY=

# Domains that should bypass the proxy (comma-separated)
# Typical local values. Add any internal hosts as needed.
NO_PROXY=localhost,127.0.0.1,::1

# Facebook scraping controls
FB_MAX_POSTS=20
FB_SCROLL_ROUNDS=20
FB_PREVIEW_LEN=280
FB_MAX_COMMENTS=200
# Use a dedicated automation-only profile directory (safer)
PANTHER_PROFILE_DIR="/Users/lucas/Projects/Web/main_dashboard/var/google-chrome"
FB_PROFILE_CLONE_RUN=1
# Leave subprofile empty when using a dedicated dir (defaults to "Default")
FB_PROFILE_DIR_NAME=""
FB_FORCE_UNLOCK_PROFILE=1
FB_UCD_LOGIN=0
FB_USER_AGENT='Mozilla/5.0 (Macintosh; Intel Mac OS X 14_5) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36'
FB_LANG=en-US
FB_PYTHON_BIN="/Users/lucas/Projects/Web/main_dashboard/.venv311/bin/python"
FB_DEBUG=1
